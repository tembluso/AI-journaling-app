OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_CHAT_FALLBACK=gpt-3.5-turbo

# Local dev default: sqlite:///./notes.db
#
# Supabase Postgres: use the SESSION POOLER host, not the direct db.<ref>.supabase.co
# host. The direct host is IPv6-only by default and will fail to resolve on
# most home/office networks (psycopg2.OperationalError: could not translate
# host name). Pooler host/user come from Supabase dashboard > Project Settings
# > Database > Connection pooling:
#   postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
DATABASE_URL=sqlite:///./notes.db

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me

# Comma-separated list of origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
